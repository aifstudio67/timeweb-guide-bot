# Never commit the real token. Add it only as a secret environment variable in Timeweb Cloud.
TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather

# Public channel: @your_channel and https://t.me/your_channel
# Private channel: numeric ID such as -1001234567890 and an invite URL.
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel

# Create a PostgreSQL database and paste its connection string here in Timeweb Cloud.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set to true only if the database connection instructions require TLS.
DATABASE_SSL=false

PORT=3000
GUIDE_FILE_PATH=assets/timeweb-cloud-app-deploy-guide.pdf
